# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real credentials.

# --- SMTP transport ---
# Gmail: smtp.gmail.com | Outlook: smtp.office365.com | Zoho: smtp.zoho.com
SMTP_HOST=smtp.gmail.com

# 465 = implicit TLS (set SMTP_SECURE=true), 587 = STARTTLS (set SMTP_SECURE=false)
SMTP_PORT=465
SMTP_SECURE=true

# The mailbox that authenticates with the SMTP server.
SMTP_USER=your-address@gmail.com

# NOT your normal account password — generate an App Password:
#   Gmail: enable 2-Step Verification, then https://myaccount.google.com/apppasswords
#   The 16-character code can be pasted with or without spaces.
SMTP_PASS=abcd efgh ijkl mnop

# --- Message routing ---
# Where booking enquiries are delivered. Defaults to SMTP_USER if unset.
MAIL_TO=bookings@88keysstudio.com

# The From header. Must usually match SMTP_USER or the provider will reject it.
# Defaults to `88 Keys Studio <SMTP_USER>` if unset.
MAIL_FROM="88 Keys Studio <your-address@gmail.com>"

# --- Google reCAPTCHA v3 ---
# Register the site at https://www.google.com/recaptcha/admin and pick
# "Score based (v3)". Add every domain you serve from, plus `localhost` for dev.
#
# Safe to expose — it ships in the browser bundle.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-side only. Never prefix this one with NEXT_PUBLIC_.
RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# v3 scores traffic from 0.0 (likely bot) to 1.0 (likely human) instead of
# passing/failing outright. Bookings scoring below this are rejected.
# Defaults to 0.5. Lower it if real users get turned away.
RECAPTCHA_MIN_SCORE=0.5

# Note: when the reCAPTCHA keys are absent, verification is SKIPPED in
# development but the booking endpoint FAILS CLOSED in production, so the keys
# must be present in your deployed environment.
